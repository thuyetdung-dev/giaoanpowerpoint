# ============================================================
#  LessonStudio V11 — biến môi trường
#  Đặt trên Vercel: Project → Settings → Environment Variables
# ============================================================

# --- Chọn nguồn AI mặc định: "openai" hoặc "gemini" ---
AI_PROVIDER=openai

# --- OpenAI (trả phí) ---
# Lấy tại platform.openai.com → API keys. Khoá bắt đầu bằng sk-
OPENAI_API_KEY=sk-...
# Không bắt buộc. Bỏ trống thì phần mềm tự chọn theo danh sách mô hình của tài khoản.
OPENAI_MODEL=

# --- Google Gemini (có bậc miễn phí) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# LƯU Ý AN TOÀN
# Tuyệt đối KHÔNG đặt tên biến bắt đầu bằng NEXT_PUBLIC_ cho khoá API.
# Biến NEXT_PUBLIC_* bị nhúng thẳng vào mã chạy trong trình duyệt và ai cũng đọc được.

# ============================================================
#  ĐĂNG NHẬP (V12.11) — BẮT BUỘC, thiếu là phần mềm tự khoá lại
# ============================================================

# Chuỗi ngẫu nhiên tối thiểu 32 ký tự, dùng để KÝ cookie phiên.
# Đổi chuỗi này = đá toàn bộ mọi người ra, buộc đăng nhập lại.
AUTH_SECRET=

# Danh sách tài khoản, mỗi dòng một người, ngăn nhau bằng dấu ;
#   tên|vai trò|salt|hash          (vai trò: admin hoặc teacher)
# KHÔNG tự gõ tay: mở trang /tao-tai-khoan của chính phần mềm, nhập tên và mật
# khẩu, nó in ra sẵn dòng để dán vào đây. Mật khẩu được băm ngay tại trình
# duyệt nên không bao giờ đi qua mạng, và biến này KHÔNG chứa mật khẩu thật.
TEACHERS=
